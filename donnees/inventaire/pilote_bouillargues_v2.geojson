geometry": {"type": "Polygon", "coordinates": [[[4.429851, 43.799401], [4.429789, 43.799379], [4.429809, 43.799334], [4.429779, 43.799322], [4.429359, 43.799154], [4.429194, 43.799369], [4.429465, 43.799443], [4.429449, 43.799615], [4.429674, 43.799628], [4.429745, 43.799631], [4.429778, 43.799632], [4.429825, 43.79947], [4.429851, 43.799401]]]}, "properties": {"id": "PK_30047_008", "nom": null, "origine": "Base OpenStreetMap", "surf_m2": 1558, "foncier": "Public", "part_publique": 100, "commentaire": null, "usage": "equipement_public", "contexte": "centre_bourg", "revetement": "enrobe", "gestion": "commune", "descript": "Parking enrobé au pied de la pinède du parc Blachère, en partie dans l'ombre des arbres, ce qui gêne la lecture. Près de l'école Charles Péguy et de l'église, en limite du centre ancien et des lotissements.", "confiance": "moyenne"}}, {"type": "Feature", "geometry": {"type": "Polygon", "coordinates": [[[4.440659, 43.803188], [4.440614, 43.80335], [4.441414, 43.803465], [4.441459, 43.803303], [4.440659, 43.803188]]]}, "properties": {"id": "PK_30047_009", "nom": null, "origine": "Base OpenStreetMap", "surf_m2": 1207, "foncier": "Public", "part_publique": 100, "commentaire": null, "usage": "scolaire_sport", "contexte": "isole", "revetement": "stabilise", "gestion": "commune", "descript": "Aire rectangulaire en stabilisé, bordée de deux rangées d'arbres, le long d'un chemin rural. Elle dessert la piste de VTT et BMX et un plateau sportif. Vignes et champs tout autour, sans habitation proche.", "confiance": "haute"}}, {"type": "Feature", "geometry": {"type": "Polygon", "coordinates": [[[4.426954, 43.80067], [4.426759, 43.800792], [4.426614, 43.80077], [4.426582, 43.800797], [4.42652, 43.800803], [4.426488, 43.80091], [4.426936, 43.800999], [4.427131, 43.800701], [4.426954, 43.80067]]]}, "properties": {"id": "PK_30047_010", "nom": "Parking de la Madone", "origine": "Base OpenStreetMap", "surf_m2": 1021, "foncier": "Public", "part_publique": 100, "commentaire": null, "usage": "equipement_public", "contexte": "centre_bourg", "revetement": "enrobe", "gestion": "commune", "descript": "Petit parking enrobé et arboré, place de la Madone, à côté de la salle polyvalente de la Bergerie, du monument aux morts et de la poste. En plein centre ancien, bordé par la Grand Rue et l'avenue Pierre Mendès France.", "confiance": "haute"}}, {"type": "Feature", "geometry": {"type": "Polygon", "coordinates": [[[4.424502, 43.798129], [4.424414, 43.798293], [4.424391, 43.798412], [4.424598, 43.79847], [4.424652, 43.798367], [4.424793, 43.798406], [4.4249, 43.798251], [4.424502, 43.798129]]]}, "properties": {"id": "PK_30047_012", "nom": null, "origine": "Base OpenStreetMap", "surf_m2": 906, "foncier": "Public", "part_publique": 93, "commentaire": null, "usage": "equipement_public", "contexte": "residentiel", "revetement": "enrobe", "gestion": "commune", "descript": "Parking en L, revêtement clair qui semble enrobé, quelques arbres. Il jouxte un grand bâtiment couvert de panneaux solaires, qui semble être l'EHPAD Résidence du Languedoc ; arènes à 80 m, habitat pavillonnaire autour.", "confiance": "moyenne"}}, {"type": "Feature", "geometry": {"type": "Polygon", "coordinates": [[[4.417496, 43.799258], [4.41755, 43.799111], [4.417248, 43.799049], [4.417311, 43.798887], [4.4172, 43.79886], [4.417074, 43.799174], [4.417496, 43.799258]]]}, "properties": {"id": "PK_30047_015", "nom": null, "origine": "Base OpenStreetMap", "surf_m2": 776, "foncier": "Public", "part_publique": 100, "commentaire": null, "usage": "scolaire_sport", "contexte": "equipement", "revetement": "enrobe", "gestion": "commune", "descript": "Parking en L autour d'un bâtiment clair, au pied des courts de tennis de Bouillargues. Revêtement gris qui semble enrobé, quelques arbres. En lisière du bourg : lotissements à l'est, champs et vignes à l'ouest.", "confiance": "moyenne"}}, {"type": "Feature", "geometry": {"type": "Polygon", "coordinates": [[[4.428907, 43.799319], [4.429052, 43.799044], [4.428827, 43.798978], [4.4287, 43.799264], [4.428907, 43.799319]]]}, "properties": {"id": "PK_30047_016", "nom": null, "origine": "Base OpenStreetMap", "surf_m2": 615, "foncier": "Public", "part_publique": 100, "commentaire": null, "usage": "equipement_public", "contexte": "centre_bourg", "revetement": "enrobe", "gestion": "commune", "descript": "Parking enrobé rectangulaire à places marquées, entre l'église et la pinède du parc Blachère, près de l'école Charles Péguy. En limite du centre ancien, sur la rue du Pont de la République.", "confiance": "haute"}}, {"type": "Feature", "geometry": {"type": "Polygon", "coordinates": [[[4.428233, 43.800523], [4.428191, 43.800516], [4.428099, 43.800488], [4.428127, 43.800421], [4.42809, 43.80041], [4.427913, 43.8007], [4.427899, 43.80073], [4.427945, 43.800744], [4.427963, 43.800713], [4.42801, 43.800729], [4.428085, 43.800745], [4.428233, 43.800523]]]}, "properties": {"id": "PK_30047_019", "nom": null, "origine": "Base OpenStreetMap", "surf_m2": 455, "foncier": "Public", "part_publique": 100, "commentaire": null, "usage": "equipement_public", "contexte": "centre_bourg", "revetement": "enrobe", "gestion": "commune", "descript": "Parking enrobé étroit, en partie sous les arbres, rue de la Pompe. Il longe un bâtiment public de forme arrondie et les jardins d'un parc. Au cœur du centre ancien, près de la place du Manadier.", "confiance": "moyenne"}}, {"type": "Feature", "geometry": {"type": "Polygon", "coordinates": [[[4.423163, 43.798803], [4.423232, 43.798819], [4.423211, 43.798856], [4.42333, 43.798887], [4.423415, 43.798711], [4.423149, 43.79863], [4.423117, 43.798686], [4.423163, 43.798803]]]}, "properties": {"id": "PK_30047_021", "nom": "Parking Arènes de Bouillargues", "origine": "Base OpenStreetMap", "surf_m2": 402, "foncier": "Public", "part_publique": 100, "commentaire": null, "usage": "loisirs_tourisme", "contexte": "residentiel", "revetement": "enrobe", "gestion": "commune", "descript": "Petit parking enrobé accolé aux arènes André Dupuis, places marquées peu visibles. Il dessert les arènes ; habitat pavillonnaire tout autour, écoles à une centaine de mètres.", "confiance": "moyenne"}}, {"type": "Feature", "geometry": {"type": "Polygon", "coordinates": [[[4.435452, 43.801159], [4.435347, 43.800425], [4.43529, 43.800384], [4.435404, 43.801143], [4.435452, 43.801159]]]}, "properties": {"id": "PK_30047_023", "nom": null, "origine": "Base OpenStreetMap", "surf_m2": 323, "foncier": "Public", "part_publique": 100, "commentaire": null, "usage": "scolaire_sport", "contexte": "residentiel", "revetement": "enrobe", "gestion": "commune", "descript": "Bande de stationnement enrobée le long de la voie, en face du collège Les Fontaines. Il s'agit d'un stationnement en bord de rue plutôt que d'une aire. Lotissements de l'autre côté.", "confiance": "moyenne"}}]}